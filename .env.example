# Copy to .env and fill in real values. .env is gitignored; this file is not.

# ── PostgreSQL ──
DB_NAME=nexuswms
DB_USERNAME=admin
DB_PASSWORD=

# ── MongoDB ──
MONGO_USERNAME=admin
MONGO_PASSWORD=
MONGO_DATABASE=nexuswms

# ── Backend (Spring Boot) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=
JWT_EXPIRATION_MS=604800000
# Origin the frontend is actually served from (host-mapped frontend port, see below)
SPRING_CORS_ALLOWED_ORIGIN=http://localhost:4200

# ── Analytics (FastAPI) ──
# Comma-separated, no spaces required but allowed (whitespace is trimmed)
FASTAPI_CORS_ALLOWED_ORIGINS=http://localhost:4200

# ── Frontend (Vite build args — baked in at image build time, NOT read at runtime) ──
# Point these at the backend/analytics ports as reachable from the browser
# (i.e. the host-mapped ports, not the internal Docker service names —
# the browser runs outside the Compose network).
VITE_API_BASE_URL=http://localhost:8080/api/v1.0
VITE_WS_BASE_URL=http://localhost:8080
VITE_ANALYTICS_BASE_URL=http://localhost:8001/api/v1/analytics